# Google Gemini API Credentials
# Either GEMINI_API_KEY or GOOGLE_API_KEY is supported
GEMINI_API_KEY=

# Generation Settings
# Supported generation models: gemini-3.8-flash (default), gemini-2.5-flash, gemini-2.5-pro
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Retrieval and Embedding Settings
# Default embedding model is gemini-embedding-001 with 3072 dimensions (1-3072 supported)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

# Local Qdrant Vector Database
# QDRANT_PATH must be a persistent directory path (in-memory ':memory:' is rejected)
QDRANT_PATH=./.qdrant
QDRANT_COLLECTION=document_chunks
